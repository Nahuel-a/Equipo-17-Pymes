# ==============================================
# CREDIT BUSTERS - ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your actual values
# Do not commit the .env file to version control

# ---------------------------------------------
# CORS Configuration
# ---------------------------------------------
# Allowed domains for Cross-Origin Resource Sharing
CORS_DOMAINS="localhost:8000 localhost:3000 localhost:80 localhost:443"

# ---------------------------------------------
# Database Configuration (PostgreSQL)
# ---------------------------------------------
# Database connection settings
DATABASE_USERNAME=your_postgres_username
DATABASE_PASSWORD=your_postgres_password  
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=credit_busters_db

# Example for local development:
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=admin123
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=credit_busters

# ---------------------------------------------
# JWT Authentication Configuration
# ---------------------------------------------
# Secret key for JWT token signing (generate a secure random string)
SECRET_KEY=your_super_secret_jwt_key_here_change_this_in_production

# JWT algorithm (recommended: HS256)
ALGORITHM=HS256

# Token expiration time in minutes
EXPIRE_TOKEN=30

# Example values:
# SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
# ALGORITHM=HS256
# EXPIRE_TOKEN=30

# ---------------------------------------------
# Email Service Configuration (SendGrid)
# ---------------------------------------------
# SendGrid API Key for sending emails
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"

# Example:
# SENDGRID_API_KEY="SG.abcd1234efgh5678ijkl9012mnop3456.qrstuvwxyzABCDEFGH12345678"

# ---------------------------------------------
# Additional Configuration Notes
# ---------------------------------------------
# 1. Make sure to verify your sender email in SendGrid dashboard
# 2. For production, use environment-specific values
# 3. Never commit actual credentials to version control
# 4. Consider using a secrets management service for production